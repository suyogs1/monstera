#!/usr/bin/env bash
# `monstera` command wrapper. Picks the first interpreter that actually runs Python >= 3.10
# (python3, python, then the Windows `py -3` launcher; Windows Store stubs fail the probe).
#
# Kiro hooks call it as:  git -c alias.monstera=!tools/monstera/bin/monstera monstera <args>
# Git runs `!` aliases with its own POSIX shell from the repository root on every platform,
# so hooks need no OS-specific command.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
probe='import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'
for candidate in "python3" "python" "py -3"; do
  # shellcheck disable=SC2086 # "py -3" must split into command + flag
  if $candidate -c "$probe" >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec $candidate "$here/monstera.py" "$@"
  fi
done
echo "monstera: Python 3.10+ not found (tried python3, python, py -3)" >&2
exit 2
