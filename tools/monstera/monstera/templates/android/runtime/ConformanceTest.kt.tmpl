@@{header_slash}
package @@{package}.runtime

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test
import java.io.File

/**
 * Conformance tests: contract vectors plus every golden scenario recorded by the oracle.
 * Set MONSTERA_CONFORMANCE_OUT to a file path to also receive one JSON line per checkpoint.
 */
class ConformanceTest {
    @Test
    fun fixedPointVectors() {
        assertEquals(-1L, Fx.mul(-1L, 1L))
        assertEquals(Fx.RAW_MAX, Fx.mul(Fx.RAW_MAX, Fx.RAW_MAX))
        assertEquals(Fx.RAW_MAX, Fx.mul(Fx.RAW_MIN, Fx.RAW_MIN))
        assertEquals(-2L, Fx.mul(-3L, 32768L))
        assertEquals(-2L, Fx.mul(3L, -32768L))
        assertEquals(21845L, Fx.div(65536L, 196608L))
        assertEquals(-21845L, Fx.div(-65536L, 196608L))
        assertEquals(-21845L, Fx.div(65536L, -196608L))
        assertEquals(Fx.RAW_MAX, Fx.div(5L, 0L))
        assertEquals(Fx.RAW_MIN, Fx.div(-5L, 0L))
        assertEquals(0L, Fx.div(0L, 0L))
        assertEquals(Fx.RAW_MAX, Fx.div(Fx.RAW_MIN, -1L))
        assertEquals(Fx.RAW_MAX, Fx.neg(Fx.RAW_MIN))
        assertEquals(Fx.RAW_MAX, Fx.add(Fx.RAW_MAX, 1L))
        assertEquals(Fx.RAW_MIN, Fx.sub(Fx.RAW_MIN, 1L))
    }

    @Test
    fun randomnessVectors() {
        val ref = Pcg32(42uL, 54uL)
        assertEquals(
            listOf(0xa15c02b7u, 0x7b47f409u, 0xba1d3330u, 0x83d2f293u, 0xbfa4784bu, 0xcbed606eu),
            List(6) { ref.nextU32() },
        )
        assertEquals(0x85944171f73967e8uL, fnv1a64("foobar".toByteArray(Charsets.UTF_8)))
        assertEquals(0xaf63dc4c8601ec8cuL, fnv1a64("a".toByteArray(Charsets.UTF_8)))

        val spawn = Pcg32.forStream(12345uL, "spawn")
        assertEquals(listOf(3836204951u, 2901556457u, 1288830458u, 20171900u), List(4) { spawn.nextU32() })
        assertEquals(0xbe81daf6f5b5d3bbuL, spawn.state)
        assertEquals(0x6f4a8582f6e4629fuL, spawn.inc)

        val fx = Pcg32.forStream(12345uL, "fx")
        assertEquals(listOf(3544770967u, 1588508108u, 78643710u, 1025764217u), List(4) { fx.nextU32() })

        val bounded = Pcg32.forStream(1uL, "spawn")
        assertEquals(listOf(6u, 0u, 2u, 2u, 1u, 0u, 3u, 7u), List(8) { bounded.nextBelow(10u) })
        assertEquals(listOf(0u, 0u), List(2) { bounded.nextBelow(1u) })
        assertEquals(1771058001u, bounded.nextBelow(1u shl 31))
    }

    private class Scenario(val name: String, val seed: ULong, val ticks: Int) {
        val inputs = ArrayList<TickInput>()
        val expected = ArrayList<Checkpoint>()
    }

    private fun parseScenarios(): List<Scenario> {
        val stream = ConformanceTest::class.java.getResourceAsStream("/monstera-scenarios.txt")
        requireNotNull(stream) { "monstera-scenarios.txt is missing from the test resources" }
        val out = ArrayList<Scenario>()
        var current: Scenario? = null
        for (line in stream.bufferedReader().readLines()) {
            if (line.isEmpty() || line.startsWith("#") || line.startsWith("monstera-scenarios ")) continue
            val p = line.split(' ')
            when (p[0]) {
                "scenario" -> current = Scenario(p[1], p[2].toULong(), p[3].toInt())
                "input" -> {
                    val sc = checkNotNull(current)
                    val event = InputEvent(
                        InputType.valueOf(p[2].uppercase()), p[3].toLong(), p[4].toLong(), Direction.valueOf(p[5].uppercase()),
                    )
                    val tick = p[1].toInt()
                    val last = sc.inputs.lastOrNull()
                    if (last != null && last.tick == tick) {
                        sc.inputs[sc.inputs.size - 1] = TickInput(tick, last.events + event)
                    } else {
                        sc.inputs.add(TickInput(tick, listOf(event)))
                    }
                }
                "checkpoint" -> checkNotNull(current).expected.add(
                    Checkpoint(p[1].toInt(), p[2].toULong(16), p.subList(3, 9).map { it.toLong() }),
                )
                "end" -> { out.add(checkNotNull(current)); current = null }
                else -> error("unknown line: $line")
            }
        }
        return out
    }

    private fun hex(h: ULong): String = h.toString(16).padStart(16, '0')

    @Test
    fun goldenScenarios() {
        val scenarios = parseScenarios()
        val report = System.getenv("MONSTERA_CONFORMANCE_OUT")?.let { File(it) }
        val lines = ArrayList<String>()
        val failures = ArrayList<String>()
        for (sc in scenarios) {
            val got = replay(GeneratedRuntimeConfig.config, sc.seed, sc.ticks, sc.inputs, sc.expected.map { it.tick })
            for (g in got) {
                lines.add(
                    "{\"platform\":\"kotlin\",\"scenario\":\"${sc.name}\",\"tick\":${g.tick},\"hash\":\"${hex(g.hash)}\"," +
                        "\"observe\":[${g.observe.joinToString(",")}]}",
                )
            }
            val bad = sc.expected.zip(got).firstOrNull { (want, have) -> want != have }
            if (bad != null) {
                val fields = observableNames.indices.filter { bad.first.observe[it] != bad.second.observe[it] }
                    .joinToString { observableNames[it] }
                failures.add("${sc.name}: first divergence at tick ${bad.first.tick} (hash ${hex(bad.first.hash)} vs ${hex(bad.second.hash)}; fields: ${fields.ifEmpty { "hash only" }})")
            } else if (got.size != sc.expected.size) {
                failures.add("${sc.name}: produced ${got.size} checkpoints, expected ${sc.expected.size}")
            }
        }
        report?.writeText(lines.joinToString("\n") + "\n")
        assertTrue("no scenarios found", scenarios.isNotEmpty())
        assertTrue(failures.joinToString("\n"), failures.isEmpty())
    }
}
