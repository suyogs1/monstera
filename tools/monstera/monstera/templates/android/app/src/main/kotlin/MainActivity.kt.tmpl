@@{header_slash}
package @@{package}

import android.os.Bundle
import android.util.Log
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.material3.MaterialTheme
import @@{package}.generated.GeneratedSpec
import java.security.MessageDigest

private const val TAG = "MonsteraSpec"

class MainActivity : ComponentActivity() {
    private val session = GameSession.start()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val verified = bundledSpecMatches()
        Log.i(TAG, "spec sha256=${GeneratedSpec.SHA256} bundledMatches=$verified")
        setContent {
            MaterialTheme {
                GameScreen(GeneratedSpec.spec, verified, session)
            }
        }
    }

    /** The bundled canonical JSON must hash to the value the code was generated from. */
    private fun bundledSpecMatches(): Boolean {
        val bytes = assets.open(GeneratedSpec.SPEC_ASSET).use { it.readBytes() }
        val digest = MessageDigest.getInstance("SHA-256").digest(bytes)
        return digest.joinToString("") { "%02x".format(it) } == GeneratedSpec.SHA256
    }
}
