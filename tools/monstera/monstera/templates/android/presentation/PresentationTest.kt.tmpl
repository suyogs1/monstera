package @@{package}.presentation

import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test

/** Layout, clipping, effects and text rules (presentation only; the simulation is not involved). */
class PresentationTest {
    private val eps = 0.001f

    private fun assertInside(outer: Box, inner: Box) = assertTrue("$inner not inside $outer", outer.contains(inner))

    @Test
    fun portraitLayoutKeepsAspectAndHudAboveWorld() {
        val l = Layout(1080f, 2400f, 1080f, 1920f)
        assertEquals((2400f - l.hudHeight - l.world.h) / 2f, l.world.y - l.hudHeight, eps)   // centred below the HUD
        assertTrue(l.world.y >= l.hudHeight - eps)           // the world never overlaps the HUD bar
        assertEquals(l.world.w / l.world.h, 1080f / 1920f, 0.0001f)
        assertInside(Box(0f, 0f, 1080f, 2400f), l.world)
        assertEquals(1f, l.scale, 0.0001f)                   // width-limited
    }

    @Test
    fun landscapeLayoutFitsHeightBesideTheHudBar() {
        val l = Layout(2400f, 1080f, 1920f, 1080f)
        assertTrue(l.hudHeight >= Layout.HUD_MIN)
        assertTrue(l.world.y >= l.hudHeight - eps)
        assertEquals(l.world.w / l.world.h, 1920f / 1080f, 0.0001f)
        assertInside(Box(0f, 0f, 2400f, 1080f), l.world)
        assertEquals((2400f - l.world.w) / 2f, l.world.x, eps)  // centred, letterbox on both sides
    }

    @Test
    fun theTopInsetPushesHudAndWorldDown() {
        val plain = Layout(1080f, 2400f, 1080f, 1920f)
        val inset = Layout(1080f, 2400f, 1080f, 1920f, insetTop = 100f)
        assertEquals(100f, inset.hud.y, 0f)                       // the HUD bar starts below the inset
        assertTrue(inset.world.y >= 100f + inset.hudHeight - eps)  // and the world below the HUD bar
        assertTrue(inset.scale <= plain.scale + eps)
        assertInside(Box(0f, 0f, 1080f, 2400f), inset.world)
    }

    @Test
    fun theBottomInsetKeepsTheWorldClearOfTheGestureBar() {
        val l = Layout(1080f, 2400f, 1080f, 1920f, insetTop = 100f, insetBottom = 120f)
        assertTrue(l.world.bottom <= 2400f - 120f + eps)          // the world ends above the bar
        assertTrue(l.world.y >= 100f + l.hudHeight - eps)
        assertEquals(l.world.w / l.world.h, 1080f / 1920f, 0.0001f)
        val land = Layout(2400f, 1080f, 1920f, 1080f, insetBottom = 60f)
        assertTrue(land.world.bottom <= 1080f - 60f + eps)
        assertEquals(Layout(2400f, 1080f, 1920f, 1080f).scale > land.scale, true)   // the world shrinks to make room
    }

    @Test
    fun degenerateViewsDoNotDivideByZero() {
        assertEquals(0f, Layout(0f, 0f, 1080f, 1920f).scale, 0f)
        assertEquals(0f, Layout(100f, 100f, 0f, 10f).scale, 0f)
        val tiny = Layout(50f, 20f, 100f, 100f)
        assertTrue(tiny.hudHeight <= 20f * Layout.HUD_MAX_FRACTION + eps)   // the HUD never takes the view
        assertTrue(tiny.scale > 0f)
    }

    @Test
    fun entitiesAreClippedToTheWorldRectangle() {
        val l = Layout(1000f, 1000f, 100f, 100f)
        val inside = l.visible(Box(10f, 10f, 20f, 20f))
        val full = l.toScreen(Box(10f, 10f, 20f, 20f))
        assertNotNull(inside)
        assertEquals(full.x, inside!!.x, eps)
        assertEquals(full.w, inside.w, eps)                    // fully inside: nothing is cut off
        assertEquals(full.h, inside.h, eps)
        val right = l.visible(Box(90f, 10f, 30f, 20f))!!       // sticks out past the right edge
        assertEquals(l.world.right, right.right, eps)
        assertEquals(10f * l.scale, right.w, eps)
        assertInside(l.world, right)
        val below = l.visible(Box(10f, 95f, 20f, 20f))!!       // sticks out past the bottom edge
        assertEquals(l.world.bottom, below.bottom, eps)
        assertNull(l.visible(Box(-30f, 10f, 20f, 20f)))        // completely outside
        assertNull(l.visible(Box(100f, 10f, 20f, 20f)))        // only touching the edge
    }

    private val world = Box(0f, 0f, 1000f, 1000f)
    private fun at(id: Long, kind: Int, x: Float, y: Float) = Tracked(id, kind, Box(x, y, 100f, 100f))

    @Test
    fun burstSpawnsWhenAnEffectEntityVanishesInsideTheWorld() {
        val t = EffectTracker(listOf(Effect.NONE, Effect.BURST, Effect.PICKUP), world)
        t.observe(0, 3, listOf(at(1, 1, 400f, 400f)))
        assertTrue(t.particles.isEmpty())
        t.observe(10, 3, emptyList())
        assertEquals(8, t.particles.size)
        assertEquals(450f, t.particles[0].x, eps)               // the centre of the last box
        assertEquals(1, t.particles[0].kind)
        assertEquals("+10", t.popups.firstOrNull()?.text)       // the score rose in the same frame
        t.advance(0.2f)
        assertTrue(t.particles[0].x > 450f && t.particles[0].alpha in 0.4f..0.6f)
        t.advance(0.3f)
        assertTrue(t.particles.isEmpty())
    }

    @Test
    fun pickupSpawnsARingAndNoParticles() {
        val t = EffectTracker(listOf(Effect.PICKUP), world)
        t.observe(0, 3, listOf(at(1, 0, 400f, 400f)))
        t.observe(5, 3, emptyList())
        assertEquals(1, t.rings.size)
        assertTrue(t.particles.isEmpty())
        t.advance(0.15f)
        assertEquals(50f, t.rings[0].radius, eps)
        t.advance(0.2f)
        assertTrue(t.rings.isEmpty())
    }

    @Test
    fun noEffectForKindNoneOrWhenLeavingTheWorld() {
        val t = EffectTracker(listOf(Effect.NONE, Effect.BURST), world)
        t.observe(0, 3, listOf(at(1, 0, 400f, 400f), at(2, 1, 950f, 400f)))   // #2 sticks out past the edge
        t.observe(0, 3, emptyList())
        assertTrue(t.particles.isEmpty() && t.rings.isEmpty() && t.popups.isEmpty())
    }

    @Test
    fun noPopupWithoutAScoreIncrease() {
        val t = EffectTracker(listOf(Effect.BURST), world)
        t.observe(7, 3, listOf(at(1, 0, 400f, 400f)))
        t.observe(7, 3, emptyList())
        assertEquals(8, t.particles.size)
        assertTrue(t.popups.isEmpty())
    }

    @Test
    fun losingALifeFlashesAndShakesThenSettles() {
        val t = EffectTracker(listOf(Effect.NONE), world)
        t.observe(0, 3, emptyList())
        assertEquals(0f, t.flash, 0f)
        assertEquals(0f, t.shakeX(), 0f)
        t.observe(0, 2, emptyList())
        assertEquals(1f, t.flash, 0f)
        assertTrue(Math.abs(t.shakeX()) > 0f)
        assertEquals(t.shakeX() * -0.5f, t.shakeY(), 0f)
        t.advance(0.3f)
        assertEquals(0f, t.flash, 0f)
        assertEquals(0f, t.shakeX(), 0f)
    }

    @Test
    fun gainingALifeOrResettingDoesNotFlash() {
        val t = EffectTracker(listOf(Effect.BURST), world)
        t.observe(0, 2, listOf(at(1, 0, 400f, 400f)))
        t.observe(0, 3, emptyList())
        assertEquals(0f, t.flash, 0f)
        t.reset()
        assertTrue(t.particles.isEmpty() && t.popups.isEmpty())
        t.observe(0, 1, emptyList())                            // first frame after a reset has nothing to compare
        assertEquals(0f, t.flash, 0f)
    }

    @Test
    fun effectCountsAreBounded() {
        val t = EffectTracker(listOf(Effect.BURST), world)
        val many = (1L..40L).map { at(it, 0, 400f, 400f) }
        t.observe(0, 3, many)
        t.observe(400, 3, emptyList())
        assertEquals(EffectTracker.MAX_PARTICLES, t.particles.size)
        assertEquals(1, t.popups.size)
    }

    @Test
    fun hudTextDefaultsAndGlyphs() {
        assertEquals("lives 3", Texts.lives("", 3))             // the neutral value of hud.lifeGlyph
        assertEquals("lives 0", Texts.lives("", -2))
        assertEquals("\u2665\u2665\u2665", Texts.lives("\u2665", 3))
        assertEquals("", Texts.lives("\u2665", 0))
        assertEquals("\u2665".repeat(8) + " +4", Texts.lives("\u2665", 12))
        assertEquals("score 40", Texts.score("score", 40))
    }

    @Test
    fun endCardTitleFollowsLivesAndGlyphsFitTheirBox() {
        assertEquals("You win", Texts.endTitle(2, "You win", "Game over"))
        assertEquals("Game over", Texts.endTitle(0, "You win", "Game over"))
        assertEquals(90f, Texts.glyphSize(Box(0f, 0f, 200f, 100f)), eps)
        assertFalse(Texts.glyphSize(Box(0f, 0f, 0f, 100f)) > 0f)
    }
}
