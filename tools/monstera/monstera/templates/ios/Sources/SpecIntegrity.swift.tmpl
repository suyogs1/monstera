@@{header_slash}
import CryptoKit
import Foundation

/// Checks that the bundled canonical JSON is the one this code was generated from:
/// its SHA-256 must match, and decoding it with the generated models must equal the constant.
enum SpecIntegrity {
    struct Result: Sendable {
        let hashMatches: Bool
        let decodedMatches: Bool

        var label: String { hashMatches && decodedMatches ? "verified" : "MISMATCH" }
    }

    static func check() -> Result {
        let name = (GeneratedSpec.resourceName as NSString).deletingPathExtension
        guard let url = Bundle.module.url(forResource: name, withExtension: "json"),
              let data = try? Data(contentsOf: url) else {
            return Result(hashMatches: false, decodedMatches: false)
        }
        let hex = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
        let decoded = try? JSONDecoder().decode(MonsteraSpec.self, from: data)
        return Result(hashMatches: hex == GeneratedSpec.sha256, decodedMatches: decoded == GeneratedSpec.spec)
    }
}
