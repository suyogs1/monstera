// Default for the extension point: linked only when <project>/extensions/ios/MonsteraExtensions does not exist.
// A developer-owned package there replaces it with its own MonsteraExtensions library of the same shape.
import PackageDescription

let package = Package(
    name: "MonsteraExtensionDefaults",
    platforms: [
        .iOS("@@{ios_target}"),
    ],
    products: [
        .library(name: "MonsteraExtensions", targets: ["MonsteraExtensions"]),
    ],
    targets: [
        .target(name: "MonsteraExtensions"),
    ]
)
