// Deterministic simulation core. Contract: architecture/RUNTIME-CONTRACT.md.
// No floating point, no clock, no system randomness, no hash-ordered iteration.

public enum ExitPolicy: Sendable { case despawn, clamp, bounce }
public enum InputType: Sendable { case press, release, tap, drag, swipe }
public enum Direction: Sendable { case none, up, down, left, right }

public struct KindConfig: Sendable {
    public let id: String
    public let width: Int64
    public let height: Int64
    public let lifetimeTicks: Int
    public let exitPolicy: ExitPolicy
    public init(id: String, width: Int64, height: Int64, lifetimeTicks: Int, exitPolicy: ExitPolicy) {
        self.id = id; self.width = width; self.height = height
        self.lifetimeTicks = lifetimeTicks; self.exitPolicy = exitPolicy
    }
}

public struct InitialEntity: Sendable {
    public let kind: String
    public let x: Int64, y: Int64, vx: Int64, vy: Int64
    public let controlled: Bool
    public init(kind: String, x: Int64, y: Int64, vx: Int64, vy: Int64, controlled: Bool) {
        self.kind = kind; self.x = x; self.y = y; self.vx = vx; self.vy = vy; self.controlled = controlled
    }
}

public struct SpawnerConfig: Sendable {
    public let stream: String
    public let kind: String
    public let intervalTicks: Int
    public let xMin: Int64, xMax: Int64, yMin: Int64, yMax: Int64
    public let vx: Int64, vy: Int64
    public init(stream: String, kind: String, intervalTicks: Int, xMin: Int64, xMax: Int64,
                yMin: Int64, yMax: Int64, vx: Int64, vy: Int64) {
        self.stream = stream; self.kind = kind; self.intervalTicks = intervalTicks
        self.xMin = xMin; self.xMax = xMax; self.yMin = yMin; self.yMax = yMax; self.vx = vx; self.vy = vy
    }
}

public struct CollisionRule: Sendable {
    public let a: String, b: String
    public let despawnA: Bool, despawnB: Bool
    public let score: Int64, lives: Int64
    public init(a: String, b: String, despawnA: Bool, despawnB: Bool, score: Int64, lives: Int64) {
        self.a = a; self.b = b; self.despawnA = despawnA; self.despawnB = despawnB
        self.score = score; self.lives = lives
    }
}

public struct RuntimeConfig: Sendable {
    public let worldWidth: Int64, worldHeight: Int64
    public let maxEntities: Int
    public let lives: Int64
    public let winScore: Int64
    public let dragGain: Int64, swipeSpeed: Int64
    public let tapKind: String
    public let tapVx: Int64, tapVy: Int64
    public let kinds: [KindConfig]
    public let initialEntities: [InitialEntity]
    public let spawners: [SpawnerConfig]
    public let collisions: [CollisionRule]
    public init(worldWidth: Int64, worldHeight: Int64, maxEntities: Int, lives: Int64, winScore: Int64,
                dragGain: Int64, swipeSpeed: Int64, tapKind: String, tapVx: Int64, tapVy: Int64,
                kinds: [KindConfig], initialEntities: [InitialEntity], spawners: [SpawnerConfig],
                collisions: [CollisionRule]) {
        self.worldWidth = worldWidth; self.worldHeight = worldHeight; self.maxEntities = maxEntities
        self.lives = lives; self.winScore = winScore; self.dragGain = dragGain; self.swipeSpeed = swipeSpeed
        self.tapKind = tapKind; self.tapVx = tapVx; self.tapVy = tapVy; self.kinds = kinds
        self.initialEntities = initialEntities; self.spawners = spawners; self.collisions = collisions
    }
}

public struct InputEvent: Sendable {
    public let type: InputType
    public let dx: Int64, dy: Int64
    public let dir: Direction
    public init(_ type: InputType, dx: Int64 = 0, dy: Int64 = 0, dir: Direction = .none) {
        self.type = type; self.dx = dx; self.dy = dy; self.dir = dir
    }
}

public struct Entity: Equatable, Sendable {
    public var id: UInt32
    public var kind: Int
    public var controlled: Bool
    public var x: Int64, y: Int64, vx: Int64, vy: Int64
    public var age: UInt32
}

/// Ordered observable fields recorded with every checkpoint.
public let observableNames = ["tick", "score", "lives", "entityCount", "ended", "nextId"]

public struct World: Sendable {
    public let config: RuntimeConfig
    public private(set) var tick: UInt32 = 0
    public private(set) var nextId: UInt32 = 1
    public private(set) var score: Int64 = 0
    public private(set) var lives: Int64
    public private(set) var ended = false
    public private(set) var pressed = false
    public private(set) var entities: [Entity] = []
    private let kindIndex: [String: Int]
    private let streamNames: [String]
    private var rngs: [Pcg32]          // parallel to streamNames
    private let spawnerStream: [Int]   // spawner index -> stream index
    private let spawnerKind: [Int]
    private let ruleKinds: [(Int, Int)]
    private let tapKindIndex: Int      // -1 when there is no tap action

    public init(config: RuntimeConfig, seed: UInt64) {
        self.config = config
        lives = config.lives
        var index: [String: Int] = [:]
        for (i, k) in config.kinds.enumerated() { index[k.id] = i }
        kindIndex = index
        let names = Array(Set(config.spawners.map { $0.stream }))
            .sorted { Array($0.utf8).lexicographicallyPrecedes(Array($1.utf8)) }
        streamNames = names
        rngs = names.map { Pcg32(seed: seed, stream: $0) }
        spawnerStream = config.spawners.map { sp in names.firstIndex(of: sp.stream) ?? 0 }
        spawnerKind = config.spawners.map { index[$0.kind] ?? 0 }
        ruleKinds = config.collisions.map { (index[$0.a] ?? 0, index[$0.b] ?? 0) }
        tapKindIndex = config.tapKind.isEmpty ? -1 : (index[config.tapKind] ?? -1)
        for e in config.initialEntities {
            add(kind: index[e.kind] ?? 0, controlled: e.controlled, x: e.x, y: e.y, vx: e.vx, vy: e.vy)
        }
    }

    private mutating func add(kind: Int, controlled: Bool, x: Int64, y: Int64, vx: Int64, vy: Int64) {
        entities.append(Entity(id: nextId, kind: kind, controlled: controlled, x: x, y: y, vx: vx, vy: vy, age: 0))
        nextId += 1
    }

    private func clampToWorld(_ e: inout Entity) {
        let k = config.kinds[e.kind]
        e.x = Fx.clamp(e.x, 0, config.worldWidth - k.width)
        e.y = Fx.clamp(e.y, 0, config.worldHeight - k.height)
    }

    private mutating func apply(_ ev: InputEvent) {
        switch ev.type {
        case .press: pressed = true
        case .release: pressed = false
        case .tap:
            if tapKindIndex >= 0, entities.count < config.maxEntities,
               let src = entities.first(where: { $0.controlled }) {
                add(kind: tapKindIndex, controlled: false, x: src.x, y: src.y, vx: config.tapVx, vy: config.tapVy)
            }
        case .drag:
            for i in entities.indices where entities[i].controlled {
                entities[i].x = Fx.add(entities[i].x, Fx.mul(ev.dx, config.dragGain))
                entities[i].y = Fx.add(entities[i].y, Fx.mul(ev.dy, config.dragGain))
                clampToWorld(&entities[i])
            }
        case .swipe:
            var dx: Int64 = 0
            var dy: Int64 = 0
            switch ev.dir {
            case .none: break
            case .up: dy = -1
            case .down: dy = 1
            case .left: dx = -1
            case .right: dx = 1
            }
            for i in entities.indices where entities[i].controlled {
                entities[i].vx = Fx.sat(dx * config.swipeSpeed)
                entities[i].vy = Fx.sat(dy * config.swipeSpeed)
            }
        }
    }

    private mutating func spawn() {
        for (i, sp) in config.spawners.enumerated() where Int(tick) % sp.intervalTicks == 0 {
            // Both draws always happen, even when the entity cap skips the spawn.
            let x = sp.xMin + Int64(rngs[spawnerStream[i]].nextBelow(UInt32(sp.xMax - sp.xMin + 1)))
            let y = sp.yMin + Int64(rngs[spawnerStream[i]].nextBelow(UInt32(sp.yMax - sp.yMin + 1)))
            if entities.count < config.maxEntities {
                add(kind: spawnerKind[i], controlled: false, x: x, y: y, vx: sp.vx, vy: sp.vy)
            }
        }
    }

    private mutating func move() {
        for i in entities.indices {
            entities[i].x = Fx.add(entities[i].x, entities[i].vx)
            entities[i].y = Fx.add(entities[i].y, entities[i].vy)
            entities[i].age += 1
            let k = config.kinds[entities[i].kind]
            switch k.exitPolicy {
            case .despawn: break
            case .clamp: clampToWorld(&entities[i])
            case .bounce:
                let maxX = config.worldWidth - k.width
                let maxY = config.worldHeight - k.height
                if entities[i].x < 0 {
                    entities[i].x = Fx.neg(entities[i].x); entities[i].vx = Fx.neg(entities[i].vx)
                } else if entities[i].x > maxX {
                    entities[i].x = Fx.sub(Fx.add(maxX, maxX), entities[i].x); entities[i].vx = Fx.neg(entities[i].vx)
                }
                if entities[i].y < 0 {
                    entities[i].y = Fx.neg(entities[i].y); entities[i].vy = Fx.neg(entities[i].vy)
                } else if entities[i].y > maxY {
                    entities[i].y = Fx.sub(Fx.add(maxY, maxY), entities[i].y); entities[i].vy = Fx.neg(entities[i].vy)
                }
                clampToWorld(&entities[i])
            }
        }
    }

    /// Half-open boxes: touching edges do not overlap; a zero-size box (a point) overlaps only a box that contains it strictly inside.
    static func overlaps(_ a: Entity, _ ka: KindConfig, _ b: Entity, _ kb: KindConfig) -> Bool {
        a.x < b.x + kb.width && b.x < a.x + ka.width && a.y < b.y + kb.height && b.y < a.y + ka.height
    }

    private mutating func collideAndResolve() -> Set<UInt32> {
        var doomed = Set<UInt32>()   // membership only; never iterated
        var scoreDelta: Int64 = 0
        var livesDelta: Int64 = 0
        for (r, rule) in config.collisions.enumerated() {
            let (ka, kb) = ruleKinds[r]
            for a in entities where a.kind == ka {
                for b in entities where b.kind == kb && a.id != b.id && !(ka == kb && a.id > b.id) {
                    if World.overlaps(a, config.kinds[ka], b, config.kinds[kb]) {
                        if rule.despawnA { doomed.insert(a.id) }
                        if rule.despawnB { doomed.insert(b.id) }
                        scoreDelta += rule.score
                        livesDelta += rule.lives
                    }
                }
            }
        }
        score = Fx.sat32(score + scoreDelta)
        lives = Fx.sat32(lives + livesDelta)
        return doomed
    }

    private func isOutside(_ e: Entity) -> Bool {
        let k = config.kinds[e.kind]
        return e.x + k.width <= 0 || e.x >= config.worldWidth || e.y + k.height <= 0 || e.y >= config.worldHeight
    }

    /// One tick: input, spawn, move, collide, resolve, despawn, advance. A no-op once ended.
    public mutating func step(_ events: [InputEvent]) {
        if ended { return }
        for ev in events { apply(ev) }
        spawn()
        move()
        let doomed = collideAndResolve()
        let survivors = entities.filter { e in
            let k = config.kinds[e.kind]
            let gone = doomed.contains(e.id)
                || (k.exitPolicy == .despawn && isOutside(e))
                || (k.lifetimeTicks > 0 && Int(e.age) >= k.lifetimeTicks)
            return !gone
        }
        entities = survivors
        tick += 1
        ended = lives <= 0 || (config.winScore > 0 && score >= config.winScore)
    }

    /// Canonical little-endian serialization (contract section 6).
    public func serialize() -> [UInt8] {
        var out: [UInt8] = []
        func u8(_ v: UInt8) { out.append(v) }
        func u32(_ v: UInt32) { for s in stride(from: 0, to: 32, by: 8) { out.append(UInt8(truncatingIfNeeded: v >> UInt32(s))) } }
        func i32(_ v: Int64) { u32(UInt32(truncatingIfNeeded: v)) }
        func u64(_ v: UInt64) { for s in stride(from: 0, to: 64, by: 8) { out.append(UInt8(truncatingIfNeeded: v >> UInt64(s))) } }
        u32(1); u32(tick); u32(nextId); i32(score); i32(lives); u8(ended ? 1 : 0); u8(pressed ? 1 : 0)
        u32(UInt32(rngs.count))
        for r in rngs { u64(r.state); u64(r.inc) }
        u32(UInt32(entities.count))
        for e in entities {
            u32(e.id); u32(UInt32(e.kind)); u8(e.controlled ? 1 : 0)
            i32(e.x); i32(e.y); i32(e.vx); i32(e.vy); u32(e.age)
        }
        return out
    }

    public func stateHash() -> UInt64 { fnv1a64(serialize()) }

    /// Values in `observableNames` order.
    public func observe() -> [Int64] {
        [Int64(tick), score, lives, Int64(entities.count), ended ? 1 : 0, Int64(nextId)]
    }
}
