// swift-tools-version: @@{swift_tools}
@@{header_slash}
// Layout follows `xtool new`: exactly one library product whose target contains the @main App.
import Foundation
import PackageDescription

// E2: developer-owned native code lives outside the generator-owned ios/ tree. When
// <project>/extensions/ios/MonsteraExtensions/Package.swift exists it provides the MonsteraExtensions library;
// otherwise the generated no-op package in ExtensionDefaults does. (The extension package sits one level down because
// SwiftPM identifies a local package by its directory name and extensions/ios would collide with this ios package.)
let here = URL(fileURLWithPath: #filePath).deletingLastPathComponent()
let developerExtensions = FileManager.default.fileExists(
    atPath: here.appendingPathComponent("../extensions/ios/MonsteraExtensions/Package.swift").standardized.path)
let extensionsPath = developerExtensions ? "../extensions/ios/MonsteraExtensions" : "ExtensionDefaults"
let extensionsPackage = developerExtensions ? "MonsteraExtensions" : "ExtensionDefaults"

let package = Package(
    name: "@@{product}",
    platforms: [
        .iOS("@@{ios_target}"),
    ],
    products: [
        .library(name: "@@{product}", targets: ["@@{product}"]),
    ],
    dependencies: [
        .package(path: "Runtime"),
        .package(path: "Presentation"),
        .package(path: extensionsPath),
    ],
    targets: [
        .target(
            name: "@@{product}",
            dependencies: [
                .product(name: "MonsteraRuntime", package: "Runtime"),
                .product(name: "MonsteraPresentation", package: "Presentation"),
                .product(name: "MonsteraExtensions", package: extensionsPackage),
            ],
            resources: [@@{ios_resources}]
        ),
    ]
)
