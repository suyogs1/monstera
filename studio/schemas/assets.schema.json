{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioAssets",
  "description": "Imported images and audio with stable ids, content hashes and provenance. Bytes live beside this file under assets/<id>/<file>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "nextSeq",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "monstera.studio.assets"
    },
    "version": {
      "const": 1
    },
    "nextSeq": {
      "description": "Next unused asset sequence number. Studio generates ids as asset-NNNN from it and then increases it by one; it never decreases, on deletion or on import. It must exceed the suffix of every generated-form id in the file. Generated ids run asset-0001 to asset-99999, so 1 to 100000 is allowed and 100000 means the counter is used up. Ids of deleted assets are not stored.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "category",
          "file",
          "mime",
          "bytes",
          "sha256",
          "width",
          "height",
          "durationMs",
          "kindRefs",
          "provenance"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "audio",
              "image"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "background",
              "music",
              "sfx",
              "sprite",
              "ui"
            ]
          },
          "file": {
            "$ref": "#/$defs/fileName"
          },
          "mime": {
            "type": "string",
            "enum": [
              "audio/mpeg",
              "audio/ogg",
              "audio/wav",
              "image/gif",
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "bytes": {
            "description": "At most 5 MiB per file.",
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "width": {
            "description": "Pixels; 0 for audio.",
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "height": {
            "description": "Pixels; 0 for audio.",
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "durationMs": {
            "description": "Milliseconds; 0 for images.",
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "kindRefs": {
            "description": "Spec kind ids this asset is linked to, sorted.",
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/kindId"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "author",
              "license",
              "source",
              "tool",
              "model",
              "promptSha256",
              "acquiredOn",
              "notes"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "enum": [
                  "ai-generated",
                  "third-party-licensed",
                  "user-owned"
                ],
                "description": "Declared by the user. Studio cannot verify it."
              },
              "author": {
                "$ref": "#/$defs/text"
              },
              "license": {
                "description": "An SPDX-style license value, or proprietary-owned. Required. Supported subset in version 1: one flat sequence of identifier tokens (letters, digits, dot, plus, hyphen) joined by single spaces and the upper-case operators AND, OR and WITH; an operator word cannot be an identifier; LicenseRef-* and DocumentRef-* are ordinary tokens. Parenthesized expressions are not supported and are rejected. This is a shape check, not an SPDX parser: Studio does not verify identifiers against the SPDX list, check exceptions after WITH, normalize case, or judge whether a license is valid or whether the user owns the asset.",
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^(proprietary-owned|[A-Za-z0-9][A-Za-z0-9.+-]*( (AND|OR|WITH) [A-Za-z0-9][A-Za-z0-9.+-]*)*)$"
              },
              "source": {
                "$ref": "#/$defs/text"
              },
              "tool": {
                "$ref": "#/$defs/text"
              },
              "model": {
                "$ref": "#/$defs/text"
              },
              "promptSha256": {
                "$ref": "#/$defs/sha256OrEmpty"
              },
              "acquiredOn": {
                "description": "User-entered date (YYYY-MM-DD) or empty. Studio never writes timestamps.",
                "type": "string",
                "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
              },
              "notes": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier: a letter, then letters, digits or hyphens (2 to 32 characters). Never reused.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "kindId": {
      "description": "A spec kind or stream id (same pattern as the canonical spec's kindId).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "sha256": {
      "description": "Lowercase hex SHA-256.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256OrEmpty": {
      "description": "Lowercase hex SHA-256, or the empty string when not recorded.",
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "text": {
      "description": "Free text. Never interpolated into generated code.",
      "type": "string",
      "maxLength": 500
    },
    "fileName": {
      "description": "A bare file name. No path separators, no leading dot.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  }
}
