{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioIntegrations",
  "description": "Backend and monetization configuration. Holds no keys, no ids, no URLs. The generated scaffolding is not a live connection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "backend",
    "monetization"
  ],
  "properties": {
    "schema": {
      "const": "monstera.studio.integrations"
    },
    "version": {
      "const": 1
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "services",
        "status",
        "configFiles"
      ],
      "properties": {
        "provider": {
          "const": "firebase"
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analytics",
            "auth",
            "crashlytics",
            "firestore",
            "remoteConfig"
          ],
          "properties": {
            "analytics": {
              "type": "boolean"
            },
            "auth": {
              "type": "boolean"
            },
            "crashlytics": {
              "type": "boolean"
            },
            "firestore": {
              "type": "boolean"
            },
            "remoteConfig": {
              "type": "boolean"
            }
          }
        },
        "status": {
          "const": "scaffold"
        },
        "configFiles": {
          "description": "Files the developer adds to the native projects; git-ignored.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "GoogleService-Info.plist",
              "google-services.json"
            ]
          }
        }
      }
    },
    "monetization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "mode",
        "placements"
      ],
      "properties": {
        "provider": {
          "const": "admob"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "test"
          ],
          "description": "Never production: real ad unit ids are entered by the developer after export."
        },
        "placements": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "trigger",
              "minSecondsBetween",
              "maxPerSession",
              "rewardKind",
              "rewardAmount"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "type": "string",
                "enum": [
                  "banner",
                  "interstitial",
                  "rewarded"
                ]
              },
              "trigger": {
                "type": "string",
                "enum": [
                  "game-lost",
                  "game-start",
                  "game-won",
                  "manual"
                ]
              },
              "minSecondsBetween": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400
              },
              "maxPerSession": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "rewardKind": {
                "description": "Reward name for rewarded placements, empty otherwise.",
                "type": "string",
                "pattern": "^([a-z][a-z0-9-]{0,31})?$"
              },
              "rewardAmount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier: a letter, then letters, digits or hyphens (2 to 32 characters). Never reused.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    }
  }
}
