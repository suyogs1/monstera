{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioGameplay",
  "description": "Parameterized gameplay modules that compile into runtime.lives, winScore and collisions. No rules language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "lives",
    "score",
    "collectibles",
    "enemies",
    "planned"
  ],
  "properties": {
    "schema": {
      "const": "monstera.studio.gameplay"
    },
    "version": {
      "const": 1
    },
    "lives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "winScore"
      ],
      "properties": {
        "winScore": {
          "description": "0 disables winning by score.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "collectibles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "collectorKind",
          "points",
          "despawn"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "$ref": "#/$defs/kindId"
          },
          "collectorKind": {
            "$ref": "#/$defs/kindId"
          },
          "points": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "despawn": {
            "description": "The collectible disappears when collected.",
            "type": "boolean"
          }
        }
      }
    },
    "enemies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "targetKind",
          "livesLost",
          "despawnEnemy"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "$ref": "#/$defs/kindId"
          },
          "targetKind": {
            "$ref": "#/$defs/kindId"
          },
          "livesLost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "despawnEnemy": {
            "description": "The enemy disappears on contact.",
            "type": "boolean"
          }
        }
      }
    },
    "planned": {
      "description": "Reserved for health, power-ups and progression; always empty in version 1.",
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier: a letter, then letters, digits or hyphens (2 to 32 characters). Never reused.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "kindId": {
      "description": "A spec kind or stream id (same pattern as the canonical spec's kindId).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    }
  }
}
